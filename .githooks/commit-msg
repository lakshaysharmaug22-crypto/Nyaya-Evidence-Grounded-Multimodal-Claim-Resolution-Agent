#!/bin/sh
# Rejects AI attribution in commit messages.
if command -v grep >/dev/null 2>&1; then
  grep -qiE "co-authored-by|generated with|claude|anthropic|noreply@anthropic" "$1"
  status=$?
elif command -v findstr.exe >/dev/null 2>&1; then
  MSYS_NO_PATHCONV=1 findstr.exe /i /c:"co-authored-by" /c:"generated with" /c:"claude" /c:"anthropic" /c:"noreply@anthropic" "$1" >/dev/null 2>&1
  status=$?
else
  echo "Blocked: cannot verify commit message (grep/findstr unavailable)" >&2
  exit 1
fi
if [ "$status" -eq 0 ]; then
  echo "Blocked: AI attribution in commit message"
  exit 1
fi
if [ "$status" -gt 1 ]; then
  echo "Blocked: commit message check failed"
  exit 1
fi
