# API (Render): comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=https://your-app.vercel.app
# Web (Vercel): public URL of the deployed API
NEXT_PUBLIC_API_URL=https://support-resolution-api.onrender.com
# API: token agents enter in the console (X-Agent-Token). Unset = agent endpoints are open (local dev only)
AGENT_TOKEN=change-me
# API: where SQLite (checkpoints, idempotency, search index) and uploaded files live. Mount a disk in production
DATA_DIR=data
RATE_LIMIT_PER_MIN=30
# API: optional. Without a key the review lane uses the deterministic brief
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_INR_PER_1K_IN=0.08
LLM_INR_PER_1K_OUT=0.4
