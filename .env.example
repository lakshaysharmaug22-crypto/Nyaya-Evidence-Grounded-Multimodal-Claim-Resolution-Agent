# ---------- Web (Vercel) ----------
# Public URL of the API. Leave unset to run the UI on its built-in demo stream.
NEXT_PUBLIC_API_URL=

# ---------- API ----------
# development | production. production refuses to start without AGENT_TOKEN (16+ chars) and explicit ALLOWED_ORIGINS
NYAYA_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
# Agents enter this in the console (sent as X-Agent-Token). Unset in development = agent endpoints open
AGENT_TOKEN=
# SQLite (checkpoints, idempotency, search) and uploads. Must be on a persistent disk in production
DATA_DIR=data
RATE_LIMIT_PER_MIN=30
MAX_BODY_MB=12
# Let claim bodies carry model scores (damage_conf, ...). Default: on in development, off in production
ALLOW_SCORE_OVERRIDES=
LOG_JSON=
LOG_LEVEL=INFO

# ---------- LLM (optional) ----------
# Without a key, review-lane cases get the deterministic brief and no model is called
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Your provider's price per 1K tokens in INR, for cost reporting (check current pricing)
LLM_INR_PER_1K_IN=0.08
LLM_INR_PER_1K_OUT=0.4

# ---------- CNN (optional) ----------
# GitHub release asset of damage.int8.onnx and its sha256. Without them photos score 0.0 -> human review
CNN_MODEL_URL=
CNN_MODEL_SHA256=

# ---------- Reply delivery ----------
# dry_run (default, nothing sent) | webhook | smtp
REPLY_MODE=dry_run
# Exact addresses/numbers or @domain.com. Anything else is never sent
REPLY_ALLOWLIST=
REPLY_WEBHOOK_URL=
REPLY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
